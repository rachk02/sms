# Modèle du fichier .env. Copier en .env et remplacer chaque valeur a-remplacer.
# Le fichier .env n'est jamais versionné.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=a-remplacer
# host.docker.internal : nom sous lequel Jasmin, dans son conteneur, joint la
# plateforme pour relayer accusés et SMS entrants. En exploitation, le nom
# interne du service web doit de même figurer ici.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

POSTGRES_DB=sms
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Super-utilisateur du conteneur : ne sert qu'à créer les rôles au premier démarrage.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=a-remplacer
# Propriétaire des tables : migrations (manage.py migrate --database proprietaire).
POSTGRES_PROPRIETAIRE_USER=sms_proprietaire
POSTGRES_PROPRIETAIRE_PASSWORD=a-remplacer
# Rôle du service web, soumis au cloisonnement par ligne.
POSTGRES_APP_USER=sms_app
POSTGRES_APP_PASSWORD=a-remplacer
# Rôle des workers, qui contourne le cloisonnement.
POSTGRES_WORKER_USER=sms_worker
POSTGRES_WORKER_PASSWORD=a-remplacer
# Rôle du back-office des agents EL-IMMEKA, qui contourne le cloisonnement.
POSTGRES_BACKOFFICE_USER=sms_backoffice
POSTGRES_BACKOFFICE_PASSWORD=a-remplacer

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

RABBITMQ_USER=sms
RABBITMQ_PASSWORD=a-remplacer
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_CONSOLE_PORT=15672

MINIO_ROOT_USER=sms
MINIO_ROOT_PASSWORD=a-remplacer
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Point d'entrée des métriques : jeton exigé en en-tête Authorization.
METRIQUES_JETON=a-remplacer

# Passerelle Jasmin et simulateur de SMSC (profil passerelle)
JASMIN_JCLI_USER=sms-admin
JASMIN_JCLI_PASSWORD=a-remplacer
JASMIN_JCLI_PORT=8990
JASMIN_HTTP_PORT=1401
JASMIN_HTTP_USER=sms
# Huit caractères au plus : limite des mots de passe SMPP, que Jasmin applique.
JASMIN_HTTP_PASSWORD=a-remplacer
SMSC_WEB_PORT=12775

# Secret des jetons des adresses de rappel des passerelles.
RAPPELS_SECRET=a-remplacer
